{
  "name": "@wytcab/projection-core",
  "version": "0.1.0",
  "description": "Framework primitives for Project Coxswain lenses: lens interface, prompt-template loader, MCP wrapper, and output schemas.",
  "license": "MIT",
  "author": "Vilhelm Drosjer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wytcab/projection-core.git"
  },
  "homepage": "https://github.com/wytcab/projection-core#readme",
  "bugs": {
    "url": "https://github.com/wytcab/projection-core/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests in Phase 0; typecheck is the gate. Run 'pnpm typecheck'.\" && exit 0",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lens",
    "framework",
    "agent-tooling",
    "cognitive-primitives",
    "mcp"
  ]
}
